{
  "manifest_version": 3,
  "name": "Podiatrist Finder — footbackpain.com",
  "short_name": "Podiatrist Finder",
  "version": "1.0.0",
  "description": "Find the closest podiatrist or foot & back pain clinic near you, with educational guides and practitioner listings from footbackpain.com.",
  "permissions": [
    "geolocation",
    "storage"
  ],
  "host_permissions": [
    "https://nominatim.openstreetmap.org/*",
    "https://overpass-api.de/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Find a Podiatrist — footbackpain.com",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
